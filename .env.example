# Copia este archivo como ".env" y completa los valores. ".env" está en .gitignore: NUNCA lo subas.
# Estas variables NO las lee la página web: se cargan en el servidor (Apps Script) con
#   node tools/gen-setup.js   → ver DESPLIEGUE.md, paso 3.

# --- IA (obligatoria) ---
ANTHROPIC_API_KEY=sk-ant-REEMPLAZA-ESTO
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Transcripción de audio (opcional; sin esto solo funciona el botón "Dictar") ---
OPENAI_API_KEY=

# --- Límites (protegen tu gasto) ---
# Generaciones de IA por usuario y por día (se puede subir para alguien en la columna limite_diario del Sheet)
DAILY_AI_LIMIT=2
# Transcripciones de audio por usuario y por día
DAILY_TRANSCRIBE_LIMIT=2
# Tope total por día entre TODOS los usuarios (corta el gasto si alguien comparte el enlace)
GLOBAL_DAILY_AI_LIMIT=200

# --- Pruebas abiertas (cualquiera escribe su correo y se registra solo, sin aprobación) ---
# SI = auto-registro activo. NO = solo entran los correos que tú agregues en la pestaña Usuarios.
AUTO_REGISTER=SI
# Usos de IA EN TOTAL por correo de prueba (no por día). Los correos con alias (+etiqueta, puntos de Gmail) cuentan como uno.
TRIAL_LIMIT=2
# Tope de usos de prueba por día entre TODAS las personas de prueba (corta el gasto si el enlace se comparte mucho)
TRIAL_GLOBAL_DAILY_LIMIT=30
# Correos nuevos que se pueden registrar por día (evita que un bot llene tu Sheet)
TRIAL_NEW_USERS_DAILY_LIMIT=50

# --- Correo "llévate tus posts" (se envía desde TU cuenta de Google, solo cuando la persona lo pide) ---
# NO desactiva nada más: pon NO para quitar el botón de envío.
EMAIL_ENABLED=SI
# Nombre que verá quien lo reciba como remitente
EMAIL_FROM_NAME=Tu Nombre
# Tu LinkedIn (aparece al pie del correo). Debe empezar con https://
EMAIL_LINKEDIN_URL=
# Texto corto opcional bajo tu nombre, p. ej. "Si te sirvió, conversemos."
EMAIL_FOOTER_TEXT=
# A qué dirección llegan las respuestas (opcional; si queda vacío responden a tu cuenta de Google)
EMAIL_REPLY_TO=
# URL pública de la página (opcional): aparece como "Seguir probando"
SITE_URL=
# Máximo de correos por día entre todas las personas (Gmail personal permite ~100 al día)
EMAIL_DAILY_LIMIT=30

# --- Opcionales ---
# ID del Google Sheet. Solo si el script NO se creó desde el propio Sheet (Extensiones → Apps Script).
SHEET_ID=
# Texto largo y aleatorio para firmar las sesiones. Si lo dejas vacío, se genera solo.
TOKEN_SECRET=

# --- URL pública de tu Web App (la que termina en /exec). No es secreta. ---
APPS_SCRIPT_URL=

# --- Mensaje cuando alguien agota sus pruebas (se muestra en la página; opcional) ---
CONTACT_TEXT=¿Quieres seguir usándolo? Escríbeme.
# Enlace opcional (tu LinkedIn, correo web, etc.). Debe empezar con https://
CONTACT_URL=
